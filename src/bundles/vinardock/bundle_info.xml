<BundleInfo name="ChimeraX-Vinardock" version="0.1.0"
	    package="chimerax.vinardock"
	    customInit="false" minSessionVersion="1" maxSessionVersion="1">

  <!-- Fill in your contact info before submitting to the ChimeraX Toolshed. -->
  <Author>Rodrigo Quiroga</Author>
  <Email>rquiroga@unc.edu.ar</Email>
  <URL>https://github.com/rquiroga7/ChimeraX-Vinardock</URL>

  <Synopsis>Read Vinardock/PDBT docking files and define docking search boxes</Synopsis>
  <Description>Open Vinardock and DOCK PDBT/PDBQT docking files (with correct
hydrogen bonding and per-pose energies), and draw, edit and autobox a docking
search box.
  </Description>

  <Categories>
    <Category name="Binding Analysis"/>
  </Categories>

  <Dependencies>
    <Dependency name="ChimeraX-Core" version="~=1.0"/>
    <Dependency name="ChimeraX-Atomic" version="~=1.0"/>
    <Dependency name="ChimeraX-DataFormats" version="~=1.0"/>
    <Dependency name="ChimeraX-OpenCommand" version="~=1.15"/>
    <Dependency name="ChimeraX-MouseModes" version="~=1.0"/>
    <Dependency name="ChimeraX-UI" version="~=1.0"/>
    <Dependency name="ChimeraX-ViewDock" version="~=1.0"/>
  </Dependencies>

  <Providers manager="data formats">
    <Provider name="PDBT" nicknames="pdbt,pdbqt,vinardock" category="Docking results"
		suffixes=".pdbt,.pdbqt" encoding="utf-8" default_for=".pdbt,.pdbqt" />
  </Providers>

  <Providers manager="open command">
    <Provider name="PDBT" want_path="true" />
  </Providers>

  <Classifiers>
    <PythonClassifier>Development Status :: 2 - Pre-Alpha</PythonClassifier>
    <ChimeraXClassifier>Command :: dockbox :: Binding Analysis :: Define a docking search box</ChimeraXClassifier>
    <ChimeraXClassifier>Tool :: Docking Box :: Binding Analysis :: Define and edit docking search boxes</ChimeraXClassifier>
  </Classifiers>

</BundleInfo>
